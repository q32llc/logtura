{
  "name": "logtura",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predeploy": "if [ -z \"${CI:-}\" ]; then /home/erik/bin/q32-deploy-check; fi",
    "dev": "concurrently -n vite,worker -c blue,green \"pnpm dev:vite\" \"pnpm dev:worker\"",
    "dev:vite": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "build": "pnpm build:packages && vite build",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:create": "wrangler d1 create logtura",
    "db:migrate:local": "wrangler d1 migrations apply logtura --local",
    "db:migrate:remote": "wrangler d1 migrations apply logtura --remote",
    "secrets:sync": "node scripts/sync-secrets.mjs",
    "smoke:supabase_oauth": "node scripts/smoke-supabase-oauth.mjs",
    "test:workerd": "vitest run --project workerd",
    "test:core": "vitest run --project @logtura/core",
    "test:drivers": "vitest run --project '@logtura/driver-*'",
    "test:destinations": "vitest run --project '@logtura/destination-*'",
    "test:coverage": "node scripts/test-coverage.mjs",
    "test": "pnpm typecheck && vitest run && pnpm test:ui",
    "test:e2e:http": "tsx scripts/e2e-http.ts",
    "test:e2e:cleanup": "tsx scripts/e2e-http.ts --cleanup",
    "build:packages": "pnpm -r --workspace-concurrency=1 --if-present build",
    "test:packed": "node scripts/test-packed.mjs",
    "test:flow": "node scripts/test-vector-flow.mjs",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "test:ui:coverage": "vitest run --config vitest.ui.config.ts --coverage",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "test:e2e:local": "tsx scripts/e2e-local.ts",
    "test:railway-runtime": "node oss/scripts/test-railway-bun.mjs",
    "test:vercel-runtime": "node oss/scripts/test-vercel-bun.mjs",
    "test:custom-vector-flow": "node oss/scripts/test-custom-vector.mjs",
    "test:packed:service": "node --import tsx scripts/test-packed-service.mjs",
    "test:e2e:cloudflare": "node --import tsx scripts/e2e-cloudflare.mjs",
    "test:e2e:live-source": "node --import tsx scripts/e2e-live-source.mjs",
    "test:legacy-snapshot": "node scripts/verify-legacy-worker-snapshot.mjs",
    "test:supabase-runtime": "node scripts/test-supabase-flow.mjs",
    "test:ai-gateway-runtime": "node scripts/test-ai-gateway-flow.mjs",
    "test:fly-source-runtime": "node scripts/test-fly-source-flow.mjs",
    "test:metrics-runtime": "node scripts/test-metrics-flow.mjs",
    "test:supabase-refresh-runtime": "node scripts/test-supabase-refresh-flow.mjs",
    "smoke:production": "node scripts/smoke-production.mjs"
  },
  "dependencies": {
    "@logtura/cloudflare-shared": "workspace:*",
    "@logtura/core": "workspace:*",
    "@logtura/custom-vector": "workspace:*",
    "@logtura/destination-datadog-metrics": "workspace:*",
    "@logtura/destination-prometheus-remote-write": "workspace:*",
    "@logtura/destination-slack": "workspace:*",
    "@logtura/destination-webhook": "workspace:*",
    "@logtura/driver-cloudflare-ai-gateway": "workspace:*",
    "@logtura/driver-cloudflare-worker-tail": "workspace:*",
    "@logtura/driver-fly-log-tail": "workspace:*",
    "@logtura/driver-railway-logs": "workspace:*",
    "@logtura/driver-supabase-edge-logs": "workspace:*",
    "@logtura/driver-vercel-logs": "workspace:*",
    "@logtura/supabase-shared": "workspace:*",
    "@mantine/core": "^8.0.0",
    "@mantine/form": "^8.0.0",
    "@mantine/hooks": "^8.0.0",
    "@mantine/notifications": "^8.0.0",
    "@msgpack/msgpack": "^3.1.3",
    "@tabler/icons-react": "^3.26.0",
    "hono": "^4.13.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "remark-gfm": "^4.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.16.3",
    "@cloudflare/workers-types": "^4.20250109.0",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "22.19.19",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-istanbul": "4.1.11",
    "concurrently": "^9.1.0",
    "esbuild": "0.27.3",
    "jsdom": "^30.1.1",
    "miniflare": "4.20260507.1",
    "playwright": "1.63.0",
    "postcss": "^8.4.49",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "4.1.11",
    "wrangler": "^3.99.0"
  }
}
