{
  "name": "@logtura/custom-vector",
  "version": "0.3.4",
  "description": "Logtura custom Vector source and destination escape-hatch drivers.",
  "license": "Apache-2.0",
  "author": "Erik Aronesty (Logtura)",
  "homepage": "https://github.com/logtura/logtura#readme",
  "repository": {
