  },
  "peerDependencies": {
    "@logtura/core": "workspace:*"
  },
  "devDependencies": {
    "@logtura/core": "workspace:*",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22"
  }
}
