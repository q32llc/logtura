{
  "name": "@logtura/supabase-shared",
  "version": "0.2.11",
  "description": "Shared Supabase Management API plumbing used by the supabase-* logtura drivers.",
  "license": "Apache-2.0",
  "author": "Erik Aronesty (Logtura)",
  "homepage": "https://github.com/logtura/logtura#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logtura/logtura.git",
    "directory": "packages/supabase-shared"
  },
  "bugs": {
    "url": "https://github.com/logtura/logtura/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
