{
  "name": "logtura",
  "version": "0.1.0",
  "description": "Compose Vector configs from typed driver inputs. Provider and destination packages for the @logtura/* namespace.",
  "license": "Apache-2.0",
  "author": "Erik Aronesty (Logtura)",
  "homepage": "https://github.com/logtura/logtura#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logtura/logtura.git"
  },
  "bugs": {
    "url": "https://github.com/logtura/logtura/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm typecheck && vitest run",
    "test:drivers": "vitest run --project '@logtura/driver-*'",
    "test:destinations": "vitest run --project '@logtura/destination-*'"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@vitest/coverage-istanbul": "4.1.5",
    "typescript": "^5.6.3",
    "vitest": "^4.1.5"
  }
}
