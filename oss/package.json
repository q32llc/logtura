{
  "name": "logtura",
  "version": "0.1.0",
  "description": "Compose Vector configs from typed driver inputs. Provider and destination packages for the @logtura/* namespace.",
  "license": "Apache-2.0",
  "author": "Erik Aronesty (Logtura)",
  "homepage": "https://github.com/logtura/logtura#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/logtura/logtura.git"
  },
  "bugs": {
    "url": "https://github.com/logtura/logtura/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm typecheck && vitest run",
    "test:coverage": "node scripts/test-coverage.mjs",
    "test:drivers": "vitest run --project '@logtura/driver-*'",
    "test:destinations": "vitest run --project '@logtura/destination-*'",
    "build": "pnpm -r --workspace-concurrency=1 --if-present build",
    "test:packed": "node scripts/test-packed.mjs",
    "test:flow": "node scripts/test-vector-flow.mjs",
    "test:railway-runtime": "node scripts/test-railway-bun.mjs",
    "test:vercel-runtime": "node scripts/test-vercel-bun.mjs",
    "test:custom-vector-flow": "node scripts/test-custom-vector.mjs",
    "test:supabase-runtime": "node scripts/test-supabase-flow.mjs",
    "test:ai-gateway-runtime": "node scripts/test-ai-gateway-flow.mjs",
    "test:fly-source-runtime": "node scripts/test-fly-source-flow.mjs",
    "test:metrics-runtime": "node scripts/test-metrics-flow.mjs"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@vitest/coverage-istanbul": "4.1.11",
    "typescript": "^5.6.3",
    "vitest": "4.1.11",
    "esbuild": "0.27.3"
  }
}
