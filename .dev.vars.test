# Public deterministic test values. Explicit environment prevents fallback to
# developers' .dev.vars credentials in workerd integration tests.
SESSION_SECRET=test-session-secret-do-not-use-in-prod
CREDENTIAL_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
GITHUB_CLIENT_ID=test
GITHUB_CLIENT_SECRET=test
SLACK_CLIENT_ID=test
SLACK_CLIENT_SECRET=test
VERCEL_CLIENT_ID=test_vercel_client
VERCEL_CLIENT_SECRET=test_vercel_secret
RAILWAY_CLIENT_ID=test_railway_client
RAILWAY_CLIENT_SECRET=test_railway_secret
POSTMARK_API_KEY=test
FROM_EMAIL=test@example.com
